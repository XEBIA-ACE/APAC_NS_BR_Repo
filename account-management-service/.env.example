# Copy to .env and fill in values. Never commit .env.
SERVER_PORT=8080

# PostgreSQL (either DB_URL, or DB_HOST/DB_PORT/DB_NAME)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=account_management
DB_USERNAME=account_management
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
